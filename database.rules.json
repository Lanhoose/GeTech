{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor')",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor' || (auth.uid === $uid && (!data.exists() || newData.child('tipo').val() === data.child('tipo').val())))",
        ".validate": "newData.hasChildren(['email','tipo']) && (!data.exists() || newData.child('tipo').val() === data.child('tipo').val() || root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor')",
        "assinatura": {
          ".validate": "root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor' || !newData.exists() || (newData.child('plano').val() === 'Essencial' && newData.child('valorMensal').val() === 499) || (newData.child('plano').val() === 'Pro Performance' && newData.child('valorMensal').val() === 1299) || (newData.child('plano').val() === 'Enterprise' && newData.child('valorMensal').val() === root.child('solicitacoesPlanos').child($uid).child('preco').val())"
        }
      }
    },
    "estoque": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "maquinas": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "ordensServico": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "ordens": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "pedidos": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "pedidosLogs": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "funcionarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "pontos": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "postsBlog": {
  ".read": "auth != null",
  "$postId": {
    ".write": "auth != null && ((!data.exists() && newData.child('criadoPor').val() === auth.uid) || (data.exists() && (data.child('criadoPor').val() === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor')))",
    ".validate": "newData.hasChildren(['title','type','date','desc','authorName','criadoEm','criadoPor']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 150 && newData.child('desc').isString() && newData.child('desc').val().length > 0 && newData.child('desc').val().length <= 5000 && newData.child('criadoPor').val() === (data.exists() ? data.child('criadoPor').val() : auth.uid)"
  }
},
    "auditoria": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".indexOn": [
        "dataHora"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['id','dataHora','usuario','acao'])"
      }
    },
    "solicitacoesPlanos": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor')",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor' || (auth.uid === $uid && (!data.exists() || (newData.child('preco').val() === data.child('preco').val() && newData.child('status').val() === data.child('status').val()))))",
        ".validate": "newData.hasChildren(['uid','email','plano','status','criadaEm']) && newData.child('uid').val() === $uid"
      },
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'"
    },
    "chamadosChatbot": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'gestor' || (!data.exists() && newData.hasChildren(['nome','email','problema','data','status']))",
      "$id": {
        ".validate": "newData.hasChildren(['nome','email','problema','data','status'])"
      }
    }
  }
}
